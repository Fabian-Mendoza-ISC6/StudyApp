<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayoutConfig"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#89CAB4"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/img_study"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/study_image_description"
            android:scaleType="centerInside"
            android:src="@drawable/logosinfondo" />

        <TextView
            android:id="@+id/lbl_Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif"
            android:text="@string/titulo_configuracion"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConfiguracion"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/blanco_redondiado"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/icon_settings"
            android:textSize="18sp"
            app:backgroundTint="@null" />
    </RelativeLayout>

    <TextView
        android:id="@+id/lbl_Ajustes_Sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerLayout"
        android:layout_marginTop="10dp"
        android:text="@string/opciones_configuracion"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/cardConfig"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/toolbarIcons"
        android:layout_below="@id/lbl_Ajustes_Sub"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/button_rounded">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_app_header"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- TAMAÑO DE LETRA - TEXTO MÁS OSCURO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_font_size"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgFontSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/rbSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/font_small" android:textColor="@color/black" />
                    <RadioButton android:id="@+id/rbMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/font_medium" android:textColor="@color/black" android:checked="true"/>
                    <RadioButton android:id="@+id/rbLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/font_large" android:textColor="@color/black" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_language"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/blanco_redondiado"
                    android:paddingStart="10dp"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_color_materia"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="10dp"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <RadioButton android:id="@+id/rbBgVerdeAgua" android:layout_width="45dp" android:layout_height="45dp" android:button="@null" android:background="@drawable/shape_circulo" android:backgroundTint="@color/bg_verde_agua" android:foreground="@drawable/color_selection_border" android:layout_margin="8dp"/>
                        <RadioButton android:id="@+id/rbBgAzulCielo" android:layout_width="45dp" android:layout_height="45dp" android:button="@null" android:background="@drawable/shape_circulo" android:backgroundTint="@color/bg_azul_cielo" android:foreground="@drawable/color_selection_border" android:layout_margin="8dp"/>
                        <RadioButton android:id="@+id/rbBgDurazno" android:layout_width="45dp" android:layout_height="45dp" android:button="@null" android:background="@drawable/shape_circulo" android:backgroundTint="@color/bg_durazno_pastel" android:foreground="@drawable/color_selection_border" android:layout_margin="8dp"/>
                        <RadioButton android:id="@+id/rbBgRosa" android:layout_width="45dp" android:layout_height="45dp" android:button="@null" android:background="@drawable/shape_circulo" android:backgroundTint="@color/bg_rosa_suave" android:foreground="@drawable/color_selection_border" android:layout_margin="8dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="5dp">
                        <RadioButton android:id="@+id/rbBgAmarillo" android:layout_width="45dp" android:layout_height="45dp" android:button="@null" android:background="@drawable/shape_circulo" android:backgroundTint="@color/bg_amarillo_pastel" android:foreground="@drawable/color_selection_border" android:layout_margin="8dp"/>
                        <RadioButton android:id="@+id/rbBgLila" android:layout_width="45dp" android:layout_height="45dp" android:button="@null" android:background="@drawable/shape_circulo" android:backgroundTint="@color/bg_lila_claro" android:foreground="@drawable/color_selection_border" android:layout_margin="8dp"/>
                        <RadioButton android:id="@+id/rbBgGris" android:layout_width="45dp" android:layout_height="45dp" android:button="@null" android:background="@drawable/shape_circulo" android:backgroundTint="@color/bg_gris_perla" android:foreground="@drawable/color_selection_border" android:layout_margin="8dp"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/black"
                    android:text="@string/btn_save_changes"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- BARRA INFERIOR -->
    <LinearLayout
        android:id="@+id/toolbarIcons"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="5dp"
        android:background="@drawable/verde_redondiado"
        android:gravity="center"
        android:orientation="horizontal">

        <Button android:id="@+id/btnInicio" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:background="@drawable/blanco_redondiado" android:text="@string/icon_home" android:textSize="22sp" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" app:backgroundTint="@null" />
        <Button android:id="@+id/btnCalendario" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:background="@drawable/blanco_redondiado" android:text="@string/icon_calendar" android:textSize="22sp" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" app:backgroundTint="@null" />
        <Button android:id="@+id/btnTareas" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:background="@drawable/blanco_redondiado" android:text="@string/icon_tasks" android:textSize="22sp" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" app:backgroundTint="@null" />
        <Button android:id="@+id/btnKamba" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:background="@drawable/blanco_redondiado" android:text="@string/icon_kanba" android:textSize="22sp" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" app:backgroundTint="@null" />
        <Button android:id="@+id/btnEventos" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:background="@drawable/blanco_redondiado" android:text="@string/icon_events" android:textSize="22sp" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" app:backgroundTint="@null" />
    </LinearLayout>

</RelativeLayout>
